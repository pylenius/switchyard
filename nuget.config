<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org: a machine-wide private feed must not be needed (or asked for credentials) to build this. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
